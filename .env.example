# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/seed-trivia.ts (a local, manually-run content-seeding
# script) - NOT read by the app itself. Get this from Supabase Dashboard >
# Project Settings > API > "service_role" secret key (NOT the anon key
# above). Never commit the real value or use it in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
